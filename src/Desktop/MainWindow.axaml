<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ZipSelect.Desktop.MainWindow" Title="ZIP Select" Width="930" Height="800" MinWidth="760" MinHeight="680">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Menu>
        <MenuItem Header="{DynamicResource File}">
          <MenuItem Name="MenuSource" Header="{DynamicResource ChooseZipArchiveFolder}"/>
          <MenuItem Name="MenuDestination" Header="{DynamicResource ChooseExtractionFolder}"/>
          <Separator/>
          <MenuItem Name="MenuOpen" Header="{DynamicResource OpenExtractionFolder}"/>
          <MenuItem Name="MenuExport" Header="{DynamicResource SaveLog}"/>
          <Separator/><MenuItem Name="MenuQuit" Header="{DynamicResource Exit}"/>
        </MenuItem>
        <MenuItem Header="{DynamicResource View}"><MenuItem Header="{DynamicResource Theme}"><MenuItem Name="ThemeLight" Header="{DynamicResource Light}" ToggleType="Radio"/><MenuItem Name="ThemeDark" Header="{DynamicResource Dark}" ToggleType="Radio"/></MenuItem><Separator/><MenuItem Name="MenuClear" Header="{DynamicResource ClearLog}"/></MenuItem>
        <MenuItem Name="LanguageMenu" Header="{DynamicResource Language}"><MenuItem Name="LanguageFrench" Header="Français" ToggleType="Radio"/><MenuItem Name="LanguageEnglish" Header="English" ToggleType="Radio"/></MenuItem>
        <MenuItem Name="OptionsMenu" Header="{DynamicResource Options}"><MenuItem Name="ConfigureOptions" Header="{DynamicResource ConfigureExtraction}"/></MenuItem>
        <MenuItem Header="{DynamicResource Help}"><MenuItem Name="MenuHelp" Header="{DynamicResource HowDoesItWork}"/><MenuItem Name="MenuAbout" Header="{DynamicResource About}"/></MenuItem>
      </Menu>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="20,9" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" FontSize="11" Text="{DynamicResource SameDestinationAndSizeSkippedZipFiles}"/><TextBlock Grid.Column="1" Name="ThemeLabel" Classes="muted" FontSize="11"/></Grid></Border>
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Image Name="AppLogo" Source="avares://ZIP-Select/Assets/logo.png" Width="80" Height="80" Stretch="Uniform" AutomationProperties.Name="ZIP Select"/>
        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{DynamicResource ExtractYourFiles}" FontSize="24" FontWeight="SemiBold"/><TextBlock Classes="muted" Text="{DynamicResource ChooseTheFileExtensionsToExtractAnd}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
      <Border Grid.Row="1" Classes="card">
        <Grid ColumnDefinitions="180,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="10">
          <TextBlock Text="{DynamicResource ZipArchiveFolder}" VerticalAlignment="Center"/><TextBox Name="Source" Grid.Column="1"/><Button Name="BrowseSource" Grid.Column="2" Content="{DynamicResource Browse}"/>
          <TextBlock Grid.Row="1" Text="{DynamicResource ExtractionFolder}" VerticalAlignment="Center"/><TextBox Name="Destination" Grid.Row="1" Grid.Column="1"/><Button Name="BrowseDestination" Grid.Row="1" Grid.Column="2" Content="{DynamicResource Browse}"/>
          <TextBlock Grid.Row="2" Text="{DynamicResource FileExtensions}" VerticalAlignment="Center"/><TextBox Name="Extensions" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Watermark=".mp3, .pdf, .jpg"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" FontSize="12" Text="{DynamicResource SeparateWithCommasForAllFiles}" TextWrapping="Wrap"/>
          <TextBlock Name="OptionsSummary" Grid.Row="4" Grid.ColumnSpan="3" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1" Padding="0,12"><TextBlock Name="Counters"/></Border>
      <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="10"><TextBlock Text="{DynamicResource ExtractionLog}" FontWeight="SemiBold"/><TextBox Name="Log" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="monospace" FontSize="12"/></Grid>
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel VerticalAlignment="Center" Spacing="8"><TextBlock Name="Status" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar Name="Progress" Minimum="0" Maximum="100" Height="5"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Name="Cancel" Content="{DynamicResource Stop}" IsVisible="False"/><Button Name="Start" Classes="primary" Content="{DynamicResource Extract}"/></StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
